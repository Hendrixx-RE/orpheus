# AI Provider Key (Pacseer automatically detects the provider & default model based on the key present)
# Option 1: Google Gemini (Recommended - Free at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Groq (Free at https://console.groq.com)
# GROQ_API_KEY=your_groq_api_key_here

# Option 3: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here

# Option 4: Anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Override default model (e.g. gemini-2.5-flash, openai/gpt-oss-120b, gpt-4o-mini)
# PACSEER_MODEL=gemini-2.5-flash
